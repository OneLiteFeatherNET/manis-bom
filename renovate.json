{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>OneLiteFeatherNET/renovate:default(OneLiteFeatherNET/manis-maintainers)"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "patch",
        "minor",
        "major"
      ],
      "automerge": true
    },
    {
      "matchPackageNames": [
        "eu.cloudnetservice.cloudnet:bom"
      ],
      "allowedVersions": "<=4.0.0-RC16"
    }
  ]
}
